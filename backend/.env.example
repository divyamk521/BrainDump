# .env

##############################################
# APP
##############################################

APP_NAME=BrainDump API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

##############################################
# DATABASE
##############################################

POSTGRES_USER=braindump
POSTGRES_PASSWORD=braindump
POSTGRES_DB=braindump
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://braindump:braindump@localhost:5432/braindump

##############################################
# REDIS
##############################################

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

REDIS_URL=redis://localhost:6379/0

##############################################
# CELERY
##############################################

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

##############################################
# QDRANT
##############################################

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=braindump

##############################################
# GROQ
##############################################

GROQ_API_KEY=YOUR_GROQ_API_KEY

CHAT_MODEL=llama-3.3-70b-versatile
VISION_MODEL=llama-3.2-11b-vision-preview
FAST_MODEL=llama-3.1-8b-instant

##############################################
# JWT
##############################################

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

##############################################
# EMBEDDINGS
##############################################

EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024

##############################################
# RAG
##############################################

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10
RERANK_TOP_K=3

##############################################
# STORAGE
##############################################

UPLOAD_DIR=uploads

##############################################
# OCR
##############################################

TESSERACT_CMD=

##############################################
# WHISPER
##############################################

WHISPER_MODEL=base

##############################################
# LANGSMITH
##############################################

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=BrainDump

##############################################
# LOGGING
##############################################

LOG_LEVEL=INFO