# ===========================
# APPLICATION
# ===========================
APP_NAME=BrainDump API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ===========================
# FASTAPI
# ===========================
HOST=0.0.0.0
PORT=8000

# ===========================
# DATABASE
# ===========================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=braindump
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/braindump

# ===========================
# QDRANT
# ===========================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=braindump
QDRANT_API_KEY=

# ===========================
# REDIS
# ===========================
REDIS_URL=redis://localhost:6379/0

# ===========================
# GROQ
# ===========================
GROQ_API_KEY=your_groq_api_key_here

# ===========================
# EMBEDDINGS
# ===========================
EMBEDDING_MODEL=BAAI/bge-m3

# ===========================
# JWT
# ===========================
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================
# LANGSMITH
# ===========================
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=BrainDump

# ===========================
# CELERY
# ===========================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===========================
# FILE STORAGE
# ===========================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=100